<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI for Windows on x86-64,
  which WiX Toolset 3's candle.exe and light.exe make with what :packaging's windowsWix task writes beside this file:
  variables.wxi, the values it takes, and files.wxs, every file of the app image, in INSTALLDIR,
  each launcher's in its own component group (Launcher.dog_vision_swing), the rest in Files,
  and the web page's in INSTALLDIR\web, in Web, but its script's source map, in Web.SourceMap.

  It installs for every user into Program Files\$(var.InstallFolder): the Compose window's dog-vision-compose.exe,
  the Swing window's dog-vision-swing.exe and the command line's dog-vision-cli.exe, each on the runtime beside them.
  Each window gets a shortcut in the Start menu's group of the product's name and one on the desktop;
  the command line, which started from a shortcut would only print its usage, gets none,
  but the installation folder goes on the system's PATH.
  The web page, in the folder web, gets a shortcut in the Start menu's group,
  which opens its index.html in the system's browser.
  Each of the four is a Feature of its own, which the installer's tree offers,
  and the web page's script's source map one under the web page's.

  Each component's GUID stays as it is, as Windows Installer counts the installations of a component by it.
  A component needs a key path, which a shortcut, an Environment or a RemoveFolderEx cannot be:
  a registry value of its own is, under HKCU for a shortcut,
  which ICE38 asks of a component in a user's profile, as the Start menu and the desktop are to it.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?include variables.wxi ?>

  <Product Id="$(var.ProductCode)" Name="$(var.ProductName)" Language="1033" Codepage="1250"
           Version="$(var.Version)" Manufacturer="$(var.Vendor)" UpgradeCode="$(var.UpgradeCode)">
    <Package Description="$(var.Description)" Manufacturer="$(var.Vendor)" InstallerVersion="200" Compressed="yes"
             InstallScope="perMachine" Platform="x64" SummaryCodepage="1250"/>
    <MediaTemplate EmbedCab="yes"/>

    <!-- Any other version installed is removed first, a later one as well as an earlier one. -->
    <MajorUpgrade AllowDowngrades="yes" Schedule="afterInstallInitialize"/>

    <!-- What the system's list of programs shows. -->
    <Icon Id="DogVision.ico" SourceFile="$(var.Icon)"/>
    <Property Id="ARPPRODUCTICON" Value="DogVision.ico"/>
    <Property Id="ARPCOMMENTS" Value="$(var.Description)"/>
    <Property Id="ARPCONTACT" Value="$(var.Vendor)"/>
    <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="$(var.InstallFolder)"/>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuGroup" Name="$(var.ProductName)"/>
      </Directory>
      <Directory Id="DesktopFolder"/>
    </Directory>

    <!-- The windows' shortcuts and the web page's, each part's apart. -->
    <DirectoryRef Id="ProgramMenuGroup">
      <Component Id="ComposeStartMenu" Guid="{7329a83f-77fe-490a-958d-b23312be8352}" Win64="yes">
        <Shortcut Id="ComposeStartMenu" Name="$(var.ProductName) (Kotlin Compose)" Target="[#dog_vision_compose.exe]"
                  WorkingDirectory="INSTALLDIR"/>
        <RemoveFolder Id="ComposeStartMenu" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\$(var.InstallFolder)" Name="ComposeStartMenu" Type="integer"
                       Value="1" KeyPath="yes"/>
      </Component>
      <Component Id="SwingStartMenu" Guid="{758faf1a-17c8-4d23-a8a8-57b7c450759e}" Win64="yes">
        <Shortcut Id="SwingStartMenu" Name="$(var.ProductName) (Java Swing)" Target="[#dog_vision_swing.exe]"
                  WorkingDirectory="INSTALLDIR"/>
        <RemoveFolder Id="SwingStartMenu" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\$(var.InstallFolder)" Name="SwingStartMenu" Type="integer"
                       Value="1" KeyPath="yes"/>
      </Component>
      <!-- The page's, with the app's icon rather than the browser's, which a shortcut to a page would show. -->
      <Component Id="WebStartMenu" Guid="{72f4a1f4-aa03-4bd0-8bf7-3f83cd2c975e}" Win64="yes">
        <Shortcut Id="WebStartMenu" Name="$(var.ProductName) (web)" Target="[#web_index.html]" Icon="DogVision.ico"/>
        <RemoveFolder Id="WebStartMenu" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\$(var.InstallFolder)" Name="WebStartMenu" Type="integer"
                       Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="ComposeDesktop" Guid="{0ac98d8f-cab7-4cd5-8ceb-d6e807785200}" Win64="yes">
        <Shortcut Id="ComposeDesktop" Name="$(var.ProductName) (Kotlin Compose)" Target="[#dog_vision_compose.exe]"
                  WorkingDirectory="INSTALLDIR"/>
        <RegistryValue Root="HKCU" Key="Software\$(var.InstallFolder)" Name="ComposeDesktop" Type="integer"
                       Value="1" KeyPath="yes"/>
      </Component>
      <Component Id="SwingDesktop" Guid="{280e5e1d-dda0-4648-a5c8-de1e94a62f80}" Win64="yes">
        <Shortcut Id="SwingDesktop" Name="$(var.ProductName) (Java Swing)" Target="[#dog_vision_swing.exe]"
                  WorkingDirectory="INSTALLDIR"/>
        <RegistryValue Root="HKCU" Key="Software\$(var.InstallFolder)" Name="SwingDesktop" Type="integer"
                       Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="INSTALLDIR">
      <!-- The installation folder at the end of the system's PATH, for the command line, removed with the product. -->
      <Component Id="CommandLinePath" Guid="{101a7ec0-9978-4415-b391-98c74f15200a}" Win64="yes">
        <Environment Id="CommandLinePath" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="yes"
                     Permanent="no"/>
        <RegistryValue Root="HKLM" Key="Software\$(var.InstallFolder)" Name="OnPath" Type="integer" Value="1"
                       KeyPath="yes"/>
      </Component>

      <!--
        The app's folder under %ProgramData%, where a window downloads ffmpeg, removed with the product,
        but not while a later version replaces it, which Windows Installer says by UPGRADINGPRODUCTCODE:
        RemoveFolderEx takes the folder from a property, which its custom action reads before costing,
        so SetProperty sets it before that action, and leaves it empty while upgrading, so that nothing is removed.
      -->
      <Component Id="DownloadedData" Guid="{bca5f5ff-f706-4370-933c-55282605a6a2}" Win64="yes">
        <util:RemoveFolderEx On="uninstall" Property="DOGVISIONDATA"/>
        <RegistryValue Root="HKLM" Key="Software\$(var.InstallFolder)" Name="RemovesData" Type="integer" Value="1"
                       KeyPath="yes"/>
      </Component>

      <!--
        The installation folder, removed whole with the product, with whatever came into it after:
        RemoveFolderEx reads the folder before costing has resolved INSTALLDIR,
        so it takes it from the registry, where the component wrote it.
      -->
      <Component Id="InstallDirRemoval" Guid="{f8ef21bd-660b-4968-bfff-fb9ff7552993}" Win64="yes">
        <util:RemoveFolderEx On="uninstall" Property="INSTALLEDDIR"/>
        <RegistryValue Root="HKLM" Key="Software\$(var.InstallFolder)" Name="InstallDir" Type="string"
                       Value="[INSTALLDIR]" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <SetProperty Id="DOGVISIONDATA" Value="[CommonAppDataFolder]$(var.ProductName)\" Before="WixRemoveFoldersEx"
                 Sequence="execute">NOT UPGRADINGPRODUCTCODE</SetProperty>
    <Property Id="INSTALLEDDIR">
      <RegistrySearch Id="InstalledDir" Root="HKLM" Key="Software\$(var.InstallFolder)" Name="InstallDir" Type="raw"
                      Win64="yes"/>
    </Property>
    <!--
      The folder the product is installed in, where neither the command line nor the dialog names another:
      Windows Installer keeps no property from one installation to the next,
      so a part added later and a later version would otherwise go into the default folder, apart from the rest.
      The dialog's choice reaches the execute sequence as INSTALLDIR, which the condition then leaves.
    -->
    <SetDirectory Id="INSTALLDIR" Value="[INSTALLEDDIR]" Sequence="both">INSTALLEDDIR AND NOT INSTALLDIR</SetDirectory>

    <!--
      The parts the installer's tree offers, each installed by default,
      as a plain or a silent install (msiexec /qn, winget) installs them, but the source map, for debugging,
      which a Level above INSTALLLEVEL's 1 leaves out until the tree or ADDLOCAL names it; ADDLOCAL names fewer.
      A later version keeps the parts installed, as MajorUpgrade migrates the Features by default.
      DogVision cannot be left out: the runtime the others run on, and what removes the app's folders;
      the folder to install into is its, which the tree's Browse changes.
    -->
    <Feature Id="DogVision" Title="$(var.ProductName)"
             Description="The runtime the GUIs and the command line run on. It is always installed."
             Level="1" Absent="disallow" AllowAdvertise="no" Display="expand" ConfigurableDirectory="INSTALLDIR">
      <ComponentGroupRef Id="Files"/>
      <ComponentRef Id="DownloadedData"/>
      <ComponentRef Id="InstallDirRemoval"/>

      <Feature Id="ComposeGui" Title="GUI (Compose Multiplatform)"
               Description="The app's window, in JetBrains' Compose Multiplatform." Level="1" AllowAdvertise="no">
        <ComponentGroupRef Id="Launcher.dog_vision_compose"/>
        <ComponentRef Id="ComposeStartMenu"/>
        <ComponentRef Id="ComposeDesktop"/>
      </Feature>
      <Feature Id="SwingGui" Title="GUI (Java Swing)"
               Description="The same window in Java's Swing, without Compose Multiplatform." Level="1"
               AllowAdvertise="no">
        <ComponentGroupRef Id="Launcher.dog_vision_swing"/>
        <ComponentRef Id="SwingStartMenu"/>
        <ComponentRef Id="SwingDesktop"/>
      </Feature>
      <Feature Id="WebGui" Title="GUI (web browser)"
               Description="The app's page, in the system's web browser, from the installed files." Level="1"
               AllowAdvertise="no" Display="expand">
        <ComponentGroupRef Id="Web"/>
        <ComponentRef Id="WebStartMenu"/>

        <Feature Id="WebSourceMap" Title="Source map"
                 Description="dog-vision.js.map, with which a browser's developer tools show the page's Kotlin sources."
                 Level="2" AllowAdvertise="no">
          <ComponentGroupRef Id="Web.SourceMap"/>
        </Feature>
      </Feature>
      <Feature Id="CommandLine" Title="Command line"
               Description="dog-vision-cli, run from a command prompt. Puts the installation folder on the PATH."
               Level="1" AllowAdvertise="no">
        <ComponentGroupRef Id="Launcher.dog_vision_cli"/>
        <ComponentRef Id="CommandLinePath"/>
      </Feature>
    </Feature>

    <!-- The dialogs: the licence, then the tree of the parts with the folder to install into, with the dog on them. -->
    <UIRef Id="WixUI_FeatureTree"/>
    <WixVariable Id="WixUILicenseRtf" Value="$(var.License)"/>
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Banner)"/>
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Dialog)"/>
  </Product>
</Wix>
