// What uses testing, in tests alone.
// ./gradlew drawModuleGraphs draws testing.svg from it.
digraph testing {
    newrank=true
    bgcolor=white
    nodesep=0.35
    node [fontname="Helvetica,Arial,sans-serif", margin="0.15,0.08"]
    edge [arrowsize=0.8]

    // The layers' titles, top to bottom, each above the next.
    {
        node [shape=plaintext, fontcolor="#555555"]
        edge [style=invis]
        layer_programs [label="the programs"]
        layer_frames [label="what the app and the\nwindows are built on"]
        layer_services [label="built on the model"]
        layer_foundations [label="the foundations"]
        layer_programs -> layer_frames -> layer_services -> layer_foundations
    }

    // Each layer's modules, on a floor with its title, which stands left of them.
    node [shape=box, style=rounded]
    { rank=same; layer_programs -> { android; web } [style=invis] }
    { rank=same; layer_frames -> { "gui-core" } [style=invis] }
    { rank=same; layer_services -> { testing } [style=invis] }
    { rank=same; layer_foundations -> { core } [style=invis] }

    // The programs, in bold, each with what it is in small letters under its name.
    android [label=<<b>android</b><br/><font point-size="10" color="#555555">Android app</font>>]
    web [label=<<b>web</b><br/><font point-size="10" color="#555555">web page</font>>]

    // What uses what: a thick arrow is api, a dashed one for tests alone.
    // core's tests point up, so their arrow does not place the layers.
    android -> testing [style=dashed]
    web -> testing [style=dashed]
    "gui-core" -> testing [style=dashed]
    testing -> core [penwidth=2.5]
    core -> testing [style=dashed, constraint=false]
}
