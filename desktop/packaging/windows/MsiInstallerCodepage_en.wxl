<?xml version="1.0" encoding="utf-8"?>
<!--
  The MSI's code page: Windows-1250, Central Europe's, in place of jpackage's Windows-1252, which has no ř for the
  vendor's name, Martin Lopatář. JDK 17's jpackage, which tools/package_msi_on_linux.sh runs, hands light.exe each
  localization in its resource directory before its own English strings; light.exe takes the code page from the
  first, and a string defined in both would clash, so this one defines none. JDK 25's hands it after its own, and
  replaces its own with a file of their name, MsiInstallerStrings_en.wxl, so tools/package_msi_on_windows.ps1 puts
  jpackage's own strings with this code page in its place.
-->
<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization" Codepage="1250"/>
